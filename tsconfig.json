{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "bot.ts",
    "index.ts",
    "handler.ts",
    "config.ts",
    "lib/**/*.ts",
    "commands/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
